# =============================================================================
# MoodLens — Python / FastAPI backend + Next.js frontend
# =============================================================================

# -----------------------------------------------------------------------------
# SECRETS — never commit these
# -----------------------------------------------------------------------------
.env
.env.local
.env.*.local
!.env.example
!.env*.example
*.pem
*.key
secrets/
credentials.json

# -----------------------------------------------------------------------------
# MoodLens runtime state (regenerated at runtime, user-specific)
# -----------------------------------------------------------------------------
backend/user_state.json
backend/session_state.json
backend/embeddings_cache.npy
backend/models/checkpoints/
evaluation/metrics.json

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg
*.egg-info/
.eggs/
dist/
build/
wheels/

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing / coverage
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover
.hypothesis/
nosetests.xml
junit.xml

# Jupyter
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Node.js / Next.js (frontend)
# -----------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Next.js build output
.next/
out/
.vercel
*.tsbuildinfo

