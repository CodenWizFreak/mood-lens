# -----------------------------------------------------------------------------
*.pt
*.pth
*.ckpt
*.onnx
*.joblib
*.pickle
*.pkl

# Embedding cache (auto-regenerated on first startup, ~2-3 min)
*.npy

# Raw dataset CSVs (too large for git — download separately)
backend/data/
data/raw/

# Experiment tracking
wandb/
mlruns/
runs/
logs/
*.log

# Hugging Face / model caches
.cache/
**/.huggingface/
**/.torch/

