# ─── Groq API ──────────────────────────────────────────────────────────────────
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Recommended free-tier models (fastest to slowest, best to worst quality):
#   llama-3.1-8b-instant      ← default, great balance
#   llama-3.3-70b-versatile   ← best quality, slightly slower
#   llama-3.2-1b-preview      ← ultra-fast, weaker reasoning
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TEMPERATURE=0.8
GROQ_MAX_TOKENS=1024

# ─── Dataset Paths (relative to backend/) ──────────────────────────────────────
METADATA_CSV=data/movies_metadata.csv
CREDITS_CSV=data/credits.csv
RATINGS_CSV=data/ratings.csv

# ─── Embedding Backend ─────────────────────────────────────────────────────────
# "local"  → sentence-transformers (free, CPU, slow first run, auto-cached)
# "voyage" → Voyage AI (better quality, needs VOYAGE_API_KEY below)
EMBEDDING_BACKEND=local
EMBEDDINGS_CACHE=embeddings_cache.npy

# ─── Voyage AI (only if EMBEDDING_BACKEND=voyage) ──────────────────────────────
# VOYAGE_API_KEY=

# ─── Runtime State Files ───────────────────────────────────────────────────────
STATE_FILE=user_state.json
SESSION_FILE=session_state.json

# ─── LightGCN ──────────────────────────────────────────────────────────────────
LIGHTGCN_CHECKPOINT=models/checkpoints/lightgcn_best.pt
LIGHTGCN_ALPHA=0.6
GNND_STEPS=50
GNND_LR=0.001

# ─── App Config ────────────────────────────────────────────────────────────────
TOP_N_RESULTS=5